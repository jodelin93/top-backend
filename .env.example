# =============================================================================
# Modern POS backend - environment variables
# Copy to .env for local development. Never commit real secrets.
# Every variable the code reads is listed here; the app validates them at
# startup (src/config/env.validation.ts) and refuses to boot when invalid.
# See docs/deployment.md for dev / staging / production differences.
# =============================================================================

# Environment: development | test | staging | production
NODE_ENV=development

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3000
API_PREFIX=api/v1
# Reported by GET /api/v1/health (defaults to package.json version)
# APP_VERSION=1.0.0
# Proxies in front of the app: hop count, true/false, or trusted subnets.
# Default: 1 in production/staging, loopback in development.
# TRUST_PROXY=1
# NODE_ENV strictness: only development and test get dev fallbacks (secrets, raw
# error messages, open /metrics, Swagger, default seed password). production,
# staging and anything else are strict.
# Swagger UI at /api/docs: on by default in development/test only; strict
# environments need ENABLE_SWAGGER=true explicitly.
# ENABLE_SWAGGER=false
# Comma-separated browser origins allowed to call the API (required outside development/test)
CORS_ORIGINS=http://localhost:3001

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=modern_pos
# Must always be false: schema changes go through migrations (npm run migration:run)
DB_SYNCHRONIZE=false
# SQL query logging: true only while debugging locally, false in staging/production
DB_LOGGING=false
# true for managed databases (Railway, RDS, ...) that require TLS
DB_SSL=false
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Redis (Bull background job queues)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Empty for a password-less local Redis. The docker-compose.yml Redis requires one
# (REDIS_PASSWORD, default local-compose-only-redis-password) when you connect to it.
REDIS_PASSWORD=
QUEUE_REDIS_DB=1

# -----------------------------------------------------------------------------
# Authentication & security
# -----------------------------------------------------------------------------
# At least 32 random characters; the app refuses to start in production/staging otherwise.
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-openssl-rand-base64-48-output
# Access token lifetime (cashiers sign in again after this)
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10
# Signs the offline selling leases tills keep (at least 32 characters; required in
# production/staging, must differ from JWT_SECRET). Generate with: openssl rand -base64 48
OFFLINE_LEASE_SECRET=replace-me-with-another-openssl-rand-base64-48-output
# Key of the HMAC under which gift card codes are stored (at least 32 characters;
# required in production/staging, must differ from the other secrets). NEVER change
# it once gift cards are sold: existing cards could no longer be found. Keep it in
# the secret store with the database backups. Generate with: openssl rand -base64 48
GIFT_CARD_CODE_SECRET=replace-me-with-a-third-openssl-rand-base64-48-output
# Development-only fallback tenant for users without a tenant membership.
# Leave unset in staging/production.

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Enabled everywhere except under Jest (NODE_ENV=test); set to force on/off.
# THROTTLE_ENABLED=true
# Anonymous requests: THROTTLE_LIMIT requests per THROTTLE_TTL seconds per client IP
# (and route).
THROTTLE_TTL=60
THROTTLE_LIMIT=300
# Login and MFA verification (brute-force protection)
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=10
# Signed-in requests are counted per store (all routes together), not per IP:
# TENANT_THROTTLE_LIMIT requests per TENANT_THROTTLE_TTL seconds per store
TENANT_THROTTLE_TTL=60
TENANT_THROTTLE_LIMIT=3000
# Store sign-up attempts per IP (POST /tenants/signup)
SIGNUP_THROTTLE_TTL=3600
SIGNUP_THROTTLE_LIMIT=5
# Expensive work (report runs, export jobs, product imports/exports): per user and route
HEAVY_THROTTLE_TTL=60
HEAVY_THROTTLE_LIMIT=20

# -----------------------------------------------------------------------------
# Store sign-up and monitoring
# -----------------------------------------------------------------------------
# Self-service store creation (POST /tenants/signup and the /signup page). Off by default.
ALLOW_SIGNUP=false
# Prometheus scrape endpoint GET /metrics (outside /api/v1). With a token, scrapers
# must send "Authorization: Bearer <token>" (openssl rand -hex 24). Without one it is
# open in development/test and disabled everywhere else. METRICS_ENABLED=false disables it.
# The same token unlocks the detailed GET /api/v1/health report (anonymous: { status } only).
# METRICS_TOKEN=
# METRICS_ENABLED=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# fatal | error | warn | log (info) | debug | verbose
LOG_LEVEL=log
# json (default in production/staging) or pretty (default elsewhere)
# LOG_FORMAT=pretty

# First owner account created by `npm run seed` (required in production)
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Platform: outbox, notifications, reconciliation (docs/features/platform-backbone.md)
# -----------------------------------------------------------------------------
# Outbox publisher poll interval (ms); OUTBOX_PUBLISHER=off disables it on this instance
# OUTBOX_POLL_MS=1000
# OUTBOX_MAX_ATTEMPTS=10
# OUTBOX_RETRY_BASE_MS=5000
# OUTBOX_RETRY_MAX_MS=3600000
# OUTBOX_RETENTION_DAYS=30
# Also copy delivered events to the Bull queue "domain-events" when Redis is up
# OUTBOX_FORWARD_TO_QUEUE=false
# How long a command's Idempotency-Key is remembered
# IDEMPOTENCY_TTL_HOURS=24
# Scheduled notification checks (ms); NOTIFICATION_CHECKS=off disables them
# NOTIFICATION_CHECK_MS=300000
# RECONCILIATION_JOBS=off disables the daily reconciliation on this instance
# E-mail notifications (disabled while SMTP_HOST is empty). Never include customer
# or payment details: e-mails carry the notification title and a link only.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=pos@example.com
# SMTP_REQUIRE_TLS=true
# Link used in notification e-mails
# APP_URL=https://pos.example.com
# Shared secret of scripts/backup-db.sh for POST /platform/backup-report (min 16 chars)
# BACKUP_REPORT_TOKEN=
